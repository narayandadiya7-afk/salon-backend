generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  OWNER
  TENANT_ADMIN
  STAFF
  USER
  ADMIN
  SALON_OWNER
  CUSTOMER
}

enum PlanType {
  BASIC
  PRO
  PRO_YEARLY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  SUSPENDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ACCESS_DENIED
  PAYMENT
}

// ─────────────────────────────────────────────
// REFERENCE DATA
// ─────────────────────────────────────────────

model Country {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  countryCode String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  states      State[]

  @@map("countries")
}

model State {
  id          Int      @id @default(autoincrement())
  name        String
  countryId   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country     Country  @relation(fields: [countryId], references: [id])
  districts   District[]

  @@unique([countryId, name])
  @@map("states")
}

model District {
  id        Int      @id @default(autoincrement())
  name      String
  stateId   Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state     State    @relation(fields: [stateId], references: [id])

  @@unique([stateId, name])
  @@map("districts")
}

// ─────────────────────────────────────────────
// CONFIG
// ─────────────────────────────────────────────

model ConfigGroup {
  id          Int      @id @default(autoincrement())
  groupName   String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  params      ConfigParam[]

  @@map("config_groups")
}

model ConfigParam {
  id          Int         @id @default(autoincrement())
  groupName   String
  paramName   String
  paramValue  String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  group       ConfigGroup @relation(fields: [groupName], references: [groupName])

  @@unique([groupName, paramName])
  @@map("config_params")
}

// ─────────────────────────────────────────────
// ROLE & PERMISSION
// ─────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  displayName String?
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Salon?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  module      String?  // e.g. "admin", "app" — for scoping
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles        RolePermission[]
  menuItems    MenuItem[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// ADMIN MENU
// ─────────────────────────────────────────────

model MenuItem {
  id             Int       @id @default(autoincrement())
  parentId       Int?
  name           String
  displayName    String
  url            String?
  icon           String?
  permissionKey  String?
  displayOrder   Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  parent         MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children       MenuItem[] @relation("MenuHierarchy")
  permission     Permission? @relation(fields: [permissionKey], references: [key])

  @@index([parentId])
  @@index([isActive])
  @@map("menu_items")
}

// ─────────────────────────────────────────────
// TENANT / SALON
// ─────────────────────────────────────────────

model Salon {
  id                  String             @id @default(cuid())
  ownerId             String             @unique
  name                String
  slug                String             @unique
  subdomain           String?            @unique
  customDomain        String?            @unique
  description         String?
  address             String?
  city                String?
  state               String?
  phone               String?
  email               String?
  logoUrl             String?
  bannerUrl           String?

  planType            PlanType           @default(BASIC)
  subscriptionStatus  SubscriptionStatus @default(TRIAL)
  subscriptionExpiry  DateTime?

  workingHours        String?   @db.Text
  slotDurationMinutes Int                @default(30)

  primaryColor        String?            @default("#1890ff")
  settings            Json?
  featureFlags        Json?

  isActive            Boolean            @default(true)
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  owner               User               @relation("OwnedSalon", fields: [ownerId], references: [id])
  users               User[]             @relation("TenantUsers")
  roles               Role[]
  services            Service[]
  appointments        Appointment[]
  payments            Payment[]
  timeSlots           TimeSlot[]
  staff               Staff[]
  subscriptions       Subscription[]
  notifications       Notification[]
  customerProfiles    CustomerProfile[]
  auditLogs           AuditLog[]

  @@index([slug])
  @@index([subdomain])
  @@index([customDomain])
  @@index([subscriptionStatus])
  @@map("salons")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  phone         String?
  roleId        String?                  // FK to roles table
  tenantId      String?
  isActive      Boolean  @default(true)
  isVerified    Boolean  @default(false)
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salon         Salon?                @relation("OwnedSalon")
  tenant        Salon?                @relation("TenantUsers", fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef       Role?                 @relation(fields: [roleId], references: [id])
  appointments  Appointment[]
  payments      Payment[]
  refreshTokens RefreshToken[]
  customerProfile CustomerProfile?
  auditLogs     AuditLog[]

  @@index([tenantId])
  @@index([roleId])
  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────
// SERVICE
// ─────────────────────────────────────────────

model Service {
  id           String   @id @default(cuid())
  salonId      String
  tenantId     String
  name         String
  description  String?
  price        Float
  duration     Int
  category     String?
  imageUrl     String?
  isActive     Boolean  @default(true)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId])
  @@index([salonId, isActive])
  @@map("services")
}

// ─────────────────────────────────────────────
// TIME SLOT
// ─────────────────────────────────────────────

model TimeSlot {
  id          String   @id @default(cuid())
  salonId     String
  tenantId    String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, dayOfWeek])
  @@index([tenantId])
  @@map("time_slots")
}

// ─────────────────────────────────────────────
// APPOINTMENT
// ─────────────────────────────────────────────

model Appointment {
  id             String            @id @default(cuid())
  salonId        String
  tenantId       String
  serviceId      String
  customerId     String?
  customerName   String
  customerEmail  String
  customerPhone  String
  appointmentDate DateTime
  startTime      String
  endTime        String
  status         AppointmentStatus @default(BOOKED)
  notes          String?
  createdBy      String?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  salon          Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  service        Service           @relation(fields: [serviceId], references: [id])
  customer       User?             @relation(fields: [customerId], references: [id])

  @@index([tenantId])
  @@index([salonId, appointmentDate])
  @@index([customerId])
  @@map("appointments")
}

// ─────────────────────────────────────────────
// PAYMENT / SUBSCRIPTION
// ─────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  userId            String
  salonId           String?
  tenantId          String?
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Float
  currency          String        @default("INR")
  planType          PlanType
  status            PaymentStatus @default(PENDING)
  webhookVerified   Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id])
  salon             Salon?        @relation(fields: [salonId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("payments")
}

model Staff {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  name      String
  email     String?
  phone     String?
  title     String?
  bio       String?
  imageUrl  String?
  isActive  Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Salon    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("staff")
}

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  priceMonthly Float
  priceYearly  Float?
  trialDays    Int     @default(14)
  features     Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id          String             @id @default(cuid())
  tenantId    String
  planId      String?
  status      SubscriptionStatus @default(TRIAL)
  startsAt    DateTime           @default(now())
  expiresAt   DateTime?
  renewedAt   DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant      Salon              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        Plan?              @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  tenant    Salon    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("notifications")
}

model CustomerProfile {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   @unique
  notes     String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Salon    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("customer_profiles")
}

model RefreshToken {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  replacedById String?
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String      @id @default(cuid())
  tenantId  String?
  userId    String?
  action    AuditAction
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  tenant    Salon?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
